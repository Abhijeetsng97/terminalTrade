# terminalTrade environment — copy to .env and fill in.
# Real environment variables override .env values.

# ---- crypto ----
# 32-byte hex master key for credential encryption at rest.
# Generate: openssl rand -hex 32
TT_ENCRYPTION_KEY=

# ---- server ----
# SSH port serving the TUI (point trade.tradeapp.in DNS here).
TT_SSH_PORT=2222
# REST API port (binds 127.0.0.1; put behind nginx/Caddy + TLS for remote use).
TT_API_PORT=8080
# Bearer token protecting the REST API. Generate: openssl rand -hex 24
TT_API_KEY=

# SSH public keys allowed to log in: a file path or newline-separated keys.
# e.g. TT_AUTHORIZED_KEYS=/etc/terminaltrade/authorized_keys
TT_AUTHORIZED_KEYS=

# ---- storage ----
TT_MONGO_URI=mongodb://localhost:27017
TT_MONGO_DB=terminaltrade

# ---- Kite Connect (Zerodha) ----
# From https://developers.kite.trade/apps — API key + secret.
KITE_API_KEY=
KITE_API_SECRET=

# ---- Fyers API v3 ----
# From https://myapi.fyers.io dashboard — App ID, secret, redirect.
FYERS_APP_ID=
FYERS_APP_SECRET=
FYERS_REDIRECT_URI=
# 2nd-factor PIN for the refresh-token flow (app pin set in the Fyers app).
FYERS_PIN=

# ---- TOTP (second factor after SSH key) ----
# Leave empty on first run: the app generates a secret, prints an
# otpauth:// enrollment URL, and persists it. Set it explicitly to
# restore a known secret.
TT_TOTP_SECRET=

# ---- trading ----
# Underlyings for the option chain pages (comma-separated).
TT_UNDERLYINGS=NIFTY,BANKNIFTY